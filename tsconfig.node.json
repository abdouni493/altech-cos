{
  "compilerOptions": {
    "composite": true,
    // Keep `tsc -b` from emitting vite.config.js / vite.config.d.ts next to the
    // source config — Vite resolves vite.config.js *before* vite.config.ts, so a
    // stale emitted copy would silently shadow the real config.
    "outDir": "./node_modules/.tmp/node-config",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["vite.config.ts"]
}
